#include <winver.h>
1 ICON "gpxpatch.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604b0"
    BEGIN
      VALUE "CompanyName", "GP3 Reborn"
      VALUE "FileDescription", "GPxPatch Reborn - configuracao do GPxPatch"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "GPxPatch Reborn"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "GPxPatch Reborn.exe"
      VALUE "LegalCopyright", "GP3 Reborn. GPxPatch (c) Rene Smit."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
